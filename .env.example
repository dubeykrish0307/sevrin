# Copy this file to .env and fill in your real keys. Never commit .env.

ANTHROPIC_API_KEY=your-anthropic-key-here

# TTS_BACKEND: "local" (macOS `say`, instant, free) or "elevenlabs" (natural, small delay, paid)
TTS_BACKEND=local
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# faster-whisper model: tiny.en, base.en, small.en (default), medium.en
WHISPER_MODEL=base

# optional whisper.cpp server, see README
# WHISPER_CPP_DIR=/full/path/to/whisper.cpp
